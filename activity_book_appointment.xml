<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/confirmBookingBtn"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Appointment"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Barber Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.05"
                android:text="CHOOSE YOUR BARBER"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/barberKgCard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gold_button"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/barberKgName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KG"
                        android:textColor="#141414"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/barberKgSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Senior Barber"
                        android:textColor="#333333"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/barberBoikhutsoCard"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/barberBoikhutsoName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boikhutso"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/barberBoikhutsoSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Master Stylist"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Service Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.05"
                android:text="SERVICE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/serviceSpinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dark_card"
                android:paddingHorizontal="16dp" />

            <!-- Date Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.05"
                android:text="DATE"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/date08"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="08\nMon"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/date09"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="09\nTue"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/date10"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_gold_button"
                        android:gravity="center"
                        android:text="10\nWed"
                        android:textColor="#141414"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/date11"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="11\nThu"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/date12"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="12\nFri"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/date13"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="13\nSat"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Time Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.05"
                android:text="TIME"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time0900"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="09:00"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/time1030"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="10:30"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time1200"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gold_button"
                        android:gravity="center"
                        android:text="12:00"
                        android:textColor="#141414"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/time1330"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="13:30"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/time1430"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="14:30"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/time1500"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dark_card"
                        android:gravity="center"
                        android:text="15:00"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Button -->
    <Button
        android:id="@+id/confirmBookingBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/gold"
        android:text="CONFIRM BOOKING – R100"
        android:textColor="#141414"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>
